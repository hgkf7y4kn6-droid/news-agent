{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "news-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Static front-end (public/index.html). Anything that isn't a file falls through to the Worker.
  "assets": { "directory": "./public", "not_found_handling": "none" },

  // Per-user preferences + chat history.
  // No "id" on purpose: Wrangler creates the namespace on the first deploy (including
  // Cloudflare's Git builds) and reuses it after that. Add an "id" only to use an existing one.
  "kv_namespaces": [
    { "binding": "USER_STATE" }
  ],

  // Article search for chat (RAG): OFF until the Vectorize index exists, because deploys fail
  // if the binding points at a missing index. Without it, chat still works but doesn't cite loaded articles.
  // To turn it on:
  //   1. Create the index in the SAME Cloudflare account the Worker deploys to:
  //        npx wrangler vectorize create news-articles --dimensions=768 --metric=cosine
  //   2. Confirm it's listed:  npx wrangler vectorize list
  //   3. Uncomment the block below and push.
  // "vectorize": [
  //   { "binding": "VECTORIZE", "index_name": "news-articles", "remote": true }
  // ],

  "vars": {
    "CHAT_MODEL": "gemini-3.8-flash",
    "EMBEDDING_MODEL": "gemini-embedding-001",

    // Chat is locked behind Cloudflare Access (see README). Until both of these are set, chat is disabled.
    // Team domain from Zero Trust -> Settings -> Custom Pages, e.g. "myteam.cloudflareaccess.com".
    "ACCESS_TEAM_DOMAIN": "",
    // "Application Audience (AUD) Tag" from the Access application's Overview tab.
    "ACCESS_AUD": "",
    // Optional extra allowlist enforced by the Worker, comma-separated. The Access policy is the primary list.
    "CHAT_ALLOWED_EMAILS": ""
  }
  // Secret (not stored here): npx wrangler secret put GEMINI_API_KEY
}
